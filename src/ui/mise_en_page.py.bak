        self.spin_pos_x = QDoubleSpinBox()
        self.spin_pos_x.setRange(-5000.0, 5000.0)
        self.spin_pos_x.setDecimals(2)
        self.spin_pos_x.setSingleStep(1.0)
        self.spin_pos_x.setSuffix(" mm")
        self.spin_pos_x.setEnabled(False)
        form_pos.addRow("X cible :", self.spin_pos_x)

        self.spin_pos_y = QDoubleSpinBox()
        self.spin_pos_y.setRange(-5000.0, 5000.0)
        self.spin_pos_y.setDecimals(2)
        self.spin_pos_y.setSingleStep(1.0)
        self.spin_pos_y.setSuffix(" mm")
        self.spin_pos_y.setEnabled(False)
        form_pos.addRow("Y cible :", self.spin_pos_y)

        self.btn_appliquer_pos = QPushButton("Deplacer la selection ici")
        self.btn_appliquer_pos.setEnabled(False)
        self.btn_appliquer_pos.clicked.connect(self.appliquer_positionnement)
        form_pos.addRow(self.btn_appliquer_pos)

        layout.addWidget(groupe_pos)

        # --- Rotation ---
        groupe_rot = QGroupBox("Rotation")
        form_rot = QFormLayout(groupe_rot)

        ligne_rot_rapide = QHBoxLayout()
        self.btn_rot_90 = QPushButton("90")
        self.btn_rot_90.setEnabled(False)
        self.btn_rot_90.clicked.connect(lambda: self.appliquer_rotation(90))
        ligne_rot_rapide.addWidget(self.btn_rot_90)

        self.btn_rot_180 = QPushButton("180")
        self.btn_rot_180.setEnabled(False)
        self.btn_rot_180.clicked.connect(lambda: self.appliquer_rotation(180))
        ligne_rot_rapide.addWidget(self.btn_rot_180)

        self.btn_rot_270 = QPushButton("270")
        self.btn_rot_270.setEnabled(False)
        self.btn_rot_270.clicked.connect(lambda: self.appliquer_rotation(270))
        ligne_rot_rapide.addWidget(self.btn_rot_270)

        form_rot.addRow("Rapide :", ligne_rot_rapide)

        self.spin_angle = QDoubleSpinBox()
        self.spin_angle.setRange(-360.0, 360.0)
        self.spin_angle.setDecimals(1)
        self.spin_angle.setSingleStep(5.0)
        self.spin_angle.setSuffix(" deg")
        self.spin_angle.setEnabled(False)
        form_rot.addRow("Angle libre :", self.spin_angle)

        self.btn_rot_libre = QPushButton("Appliquer l'angle")
        self.btn_rot_libre.setEnabled(False)
        self.btn_rot_libre.clicked.connect(
            lambda: self.appliquer_rotation(self.spin_angle.value())
        )
        form_rot.addRow(self.btn_rot_libre)

        layout.addWidget(groupe_rot)

        # --- Miroir ---
        groupe_mir = QGroupBox("Miroir")
        ligne_mir = QHBoxLayout(groupe_mir)

        self.btn_miroir_h = QPushButton("Horizontal")
        self.btn_miroir_h.setEnabled(False)
        self.btn_miroir_h.clicked.connect(self.appliquer_miroir_horizontal)
        ligne_mir.addWidget(self.btn_miroir_h)

        self.btn_miroir_v = QPushButton("Vertical")
        self.btn_miroir_v.setEnabled(False)
        self.btn_miroir_v.clicked.connect(self.appliquer_miroir_vertical)
        ligne_mir.addWidget(self.btn_miroir_v)

        layout.addWidget(groupe_mir)

        layout.addStretch()
        return panneau

    def _construire_panneau_projet(self):
        """Sous-panneau : zone de travail + origine + centrage."""
        panneau = QWidget()
        layout = QVBoxLayout(panneau)
        layout.setContentsMargins(0, 0, 0, 0)

        titre = QLabel("Projet")
        titre.setStyleSheet("font-weight: bold; padding: 2px;")
        layout.addWidget(titre)

        info = QLabel("Zone et origine se règlent\ndans la barre du haut.")
        info.setStyleSheet("color: #888; padding: 8px; font-style: italic;")
        info.setWordWrap(True)
        layout.addWidget(info)

        # --- Centrage ---
        groupe_centrage = QGroupBox("Centrage")
        layout_centrage = QVBoxLayout(groupe_centrage)

        explication = QLabel(
            "Deplace la selection (ou tout le projet) dans le coin "
            "haut-gauche de la zone, avec 5 mm de marge."
        )
        explication.setStyleSheet("color: #555; font-size: 10px; padding: 2px;")
        explication.setWordWrap(True)
        layout_centrage.addWidget(explication)

        self.btn_centrer_zone = QPushButton("Centrer dans la zone")
        self.btn_centrer_zone.setMinimumHeight(40)
        self.btn_centrer_zone.setToolTip(
            "Deplace la selection (ou tout le projet si rien n'est selectionne) "
            "pour la mettre dans le positif, avec 5 mm de marge"
        )
        self.btn_centrer_zone.clicked.connect(self.centrer_dans_zone)
        layout_centrage.addWidget(self.btn_centrer_zone)

        layout.addWidget(groupe_centrage)
        layout.addStretch()
        return panneau

    # -------------------------------------------------------------------------
    # Gestion des modes et panneaux
    # -------------------------------------------------------------------------

    def _ouvrir_dialogue_texte(self):
        """Ouvre le dialogue de saisie de texte et log les parametres
        (l'insertion reelle sera faite en 33.2)."""
        dlg = DialogueTexte(self)
        if dlg.exec() != QDialog.Accepted:
            return
        self.inserer_texte_dans_zone(
            dlg.texte_valide,
            dlg.police_valide,
            dlg.taille_valide_mm,
            dlg.gras_valide,
            dlg.italique_valide,
            dlg.souligne_valide,
            dlg.alignement_valide,
        )

    def inserer_texte_dans_zone(self, texte, police, taille_mm,
                                 gras, italique, souligne, alignement):
        """
        Convertit un texte en contours vectoriels (via QPainterPath.addText)
        et l'insere au centre de la zone de travail.

        - 1 sous-chemin (contour) = 1 Entite distincte
        - type_origine = "TEXT_<N>"
        - Echelle : ajuste la taille pour que la hauteur reelle du texte
          corresponde a taille_mm (en mm)
        """
        from PySide6.QtGui import QFont, QPainterPath
        from src.core.dxf_loader import Entite

        # --- 1. Creation du QFont (taille provisoire en pt) ---
        # On utilise 100 pt comme taille de travail (grand pour la precision)
        TAILLE_PT_TRAVAIL = 100.0
        font = QFont(police)
        font.setPointSizeF(TAILLE_PT_TRAVAIL)
        font.setBold(bool(gras))
        font.setItalic(bool(italique))
        font.setUnderline(bool(souligne))

        # --- 2. Construction du QPainterPath ---
        # QPainterPath.addText() ne gere PAS les retours a la ligne.
        # On doit decouper le texte manuellement et appeler addText()
        # une fois par ligne, en gerant l'interligne et l'alignement.
        from PySide6.QtGui import QFontMetricsF
        fm = QFontMetricsF(font)
        interligne = fm.height()  # hauteur d'une ligne (ascent + descent)

        # Alignement
        #   Qt.AlignLeft   : x = 0
        #   Qt.AlignCenter : x = -largeur_ligne / 2
        #   Qt.AlignRight  : x = -largeur_ligne
        lignes = texte.split("\n")
        path = QPainterPath()
        try:
            y_courant = 0.0
            for ligne in lignes:
                if ligne:  # ignorer les lignes vides (mais on avance quand meme)
                    largeur_ligne = fm.horizontalAdvance(ligne)
                    if alignement == Qt.AlignCenter:
                        x_offset = -largeur_ligne / 2.0
                    elif alignement == Qt.AlignRight:
                        x_offset = -largeur_ligne
                    else:
                        x_offset = 0.0
                    path.addText(x_offset, y_courant, font, ligne)
                y_courant += interligne
        except Exception as e:
            self.afficher_console(f"[Texte] Erreur de conversion : {e}")
            return

        if path.isEmpty():
            self.afficher_console("[Texte] Aucun contour genere.")
            return

        # --- 3. Mesure de la hauteur reelle du path (en unites scene) ---
        bbox_brut = path.boundingRect()
        hauteur_brute = bbox_brut.height()
        if hauteur_brute < 1e-6:
            self.afficher_console("[Texte] Hauteur de texte nulle.")
            return

        # --- 4. Facteur d'echelle pour obtenir taille_mm ---
        # 1 pt = 1/72 pouce ; 1 pouce = 25.4 mm
        POINT_VERS_MM = 25.4 / 72.0
        hauteur_brute_mm = hauteur_brute * POINT_VERS_MM
        # Facteur pour passer de la "hauteur a 100 pt" a la "hauteur desiree"
        if hauteur_brute_mm < 1e-6:
            self.afficher_console("[Texte] Hauteur nulle (mm).")
            return
        facteur = taille_mm / hauteur_brute_mm

        # --- 5. Extraction des sous-chemins ---
        # toSubpathPolygons() renvoie une QList<QPolygonF>
        sous_chemins = path.toSubpathPolygons()
        if not sous_chemins:
            self.afficher_console("[Texte] Aucun sous-chemin.")
            return

        # --- 6. Conversion en points machine (mm) ---
        # 6a. D'abord, calcul de la bbox totale apres echelle pour centrer
        xs_tous = []
        ys_tous = []
        polys_pts = []  # liste de listes de tuples (x, y) en mm (avant centrage)
        for poly in sous_chemins:
            pts = []
            for i in range(poly.size()):
                pt = poly.at(i)
                # Attention : QPainterPath a Y vers le BAS, la CNC a Y vers le BAS aussi (scene)
                # Donc on garde tel quel ; l'inversion eventuelle se fera ailleurs
                x_mm = pt.x() * POINT_VERS_MM * facteur
                y_mm = pt.y() * POINT_VERS_MM * facteur
                pts.append((x_mm, y_mm))
                xs_tous.append(x_mm)
                ys_tous.append(y_mm)
            polys_pts.append(pts)

        if not xs_tous:
            self.afficher_console("[Texte] Aucun point genere.")
            return

        # 6b. Bbox totale
        x_min_brut = min(xs_tous)
        x_max_brut = max(xs_tous)
        y_min_brut = min(ys_tous)
        y_max_brut = max(ys_tous)

        # 6c. Centre du texte
        cx_texte = (x_min_brut + x_max_brut) / 2.0
        cy_texte = (y_min_brut + y_max_brut) / 2.0

        # 6d. Position cible : milieu de la zone
        lz = float(self.largeur_zone)
        hz = float(self.hauteur_zone)
        cx_cible = lz / 2.0
        cy_cible = hz / 2.0

        # 6e. Decalage a appliquer a chaque point
        dx = cx_cible - cx_texte
        dy = cy_cible - cy_texte

        # --- 7. Choix du masque ---
        masque_cible = None
        item = self.liste_masques.currentItem()
        if item is not None:
            nom_masque = item.data(Qt.UserRole)
            masque_cible = self._trouver_masque(nom_masque)
        if masque_cible is None:
            masque_cible = self._trouver_masque(NOM_MASQUE_IMPORT)
        if masque_cible is None:
            self.afficher_console(
                "[Texte] Aucun masque disponible. Cree un masque d'abord."
            )
            return

        # --- 8. Creation d'une Entite par sous-chemin ---
        # Chaque texte recoit un ID unique (pour regrouper ses contours
        # et gerer les trous lors de la generation G-code).
        self._compteur_textes += 1
        id_texte = self._compteur_textes

        nb_entites_creees = 0
        for idx, pts in enumerate(polys_pts):
            if len(pts) < 2:
                continue

            # Application du decalage pour centrer
            points_machine = [(p[0] + dx, p[1] + dy) for p in pts]

            # Fermeture : si le premier point != dernier, on ferme
            if points_machine[0] != points_machine[-1]:
                points_machine.append(points_machine[0])

            ent = Entite(
                type_origine=f"TEXT_{id_texte}_{idx}",
                points=points_machine,
                calque=masque_cible.nom,
                couleur_aci=None,
            )

            # Item graphique
            path_item = QPainterPath()
            pts_scene = [self.origine_vers_scene(p[0], p[1])
                         for p in ent.points]
            premier = pts_scene[0]
            path_item.moveTo(premier.x(), premier.y())
            for p in pts_scene[1:]:
                path_item.lineTo(p.x(), p.y())

            item_graphique = EntiteItem(ent, path_item, masque_cible.couleur,
                                        mode_rendu=masque_cible.mode_rendu)
            self.scene.addItem(item_graphique)
            self.items_entites.append(item_graphique)
            nb_entites_creees += 1

        if nb_entites_creees == 0:
            self.afficher_console("[Texte] Aucune entite creee.")
            return

        # --- 9. Rafraichissement ---
        self._mettre_a_jour_zone_cadrage()
        self._rafraichir_liste_masques()
        self._maj_label_info()

        # --- 10. Log ---
        styles = []
        if gras:
            styles.append("gras")
        if italique:
            styles.append("italique")
        if souligne:
            styles.append("souligne")
        styles_txt = ", ".join(styles) if styles else "normal"

        self.afficher_console(
            f"[Texte] '{texte[:30]}' insere : {nb_entites_creees} contour(s), "
            f"police '{police}', taille {taille_mm:.1f} mm, styles [{styles_txt}], "
            f"masque '{masque_cible.nom}'."
        )

    def _ouvrir_bibliotheque_formes(self):
        """Ouvre la popup de choix de formes. Insere la forme choisie dans
        la zone (au centre) au clic sur Inserer."""
        dlg = DialogueBibliothequeFormes(self)
        if dlg.exec() != QDialog.Accepted:
            return
        idx = dlg.forme_choisie
        if idx is None or idx < 0 or idx >= len(FORMES_DISPONIBLES):
            return
        nom, generateur = FORMES_DISPONIBLES[idx]
        self.inserer_forme_dans_zone(nom, generateur)

    def inserer_forme_dans_zone(self, nom, generateur):
        """
        Insere une forme predefinie au centre de la zone de travail,
        avec le masque actif. Taille par defaut : 50 mm (dimension max).
        """
        from src.core.dxf_loader import Entite

        # --- 1. Points normalises de la forme ---
        try:
            pts_norm = generateur()
        except Exception as e:
            self.afficher_console(f"[Forme] Erreur de generation : {e}")
            return
        if not pts_norm or len(pts_norm) < 2:
            self.afficher_console(f"[Forme] '{nom}' vide, ignoree.")
            return

        # --- 2. BBox normalisee (pour connaitre les dimensions reelles) ---
        xs = [p[0] for p in pts_norm]
        ys = [p[1] for p in pts_norm]
        x_min_n = min(xs)
        x_max_n = max(xs)
        y_min_n = min(ys)
        y_max_n = max(ys)
        largeur_n = x_max_n - x_min_n
        hauteur_n = y_max_n - y_min_n

        if largeur_n < 1e-9 or hauteur_n < 1e-9:
            self.afficher_console(f"[Forme] '{nom}' degeneree, ignoree.")
            return

        # --- 3. Taille cible en mm : 50 mm sur la plus grande dimension ---
        TAILLE_MM = 50.0
        if largeur_n >= hauteur_n:
            # La largeur fait 50 mm -> facteur d'echelle
            facteur_mm = TAILLE_MM / largeur_n
        else:
            facteur_mm = TAILLE_MM / hauteur_n

        # --- 4. Centre de la forme normalisee ---
        cx_n = (x_min_n + x_max_n) / 2.0
        cy_n = (y_min_n + y_max_n) / 2.0

        # --- 5. Position cible : milieu de la zone de travail ---
        lz = float(self.largeur_zone)
        hz = float(self.hauteur_zone)
        cx_cible = lz / 2.0
        cy_cible = hz / 2.0

        # --- 6. Points machine ---
        points_machine = []
        for (px_n, py_n) in pts_norm:
            # Centrer sur 0, mettre a l'echelle en mm, puis deplacer au centre cible
            px_m = (px_n - cx_n) * facteur_mm + cx_cible
            py_m = (py_n - cy_n) * facteur_mm + cy_cible
            points_machine.append((px_m, py_m))

        # --- 7. Choix du masque ---
        masque_cible = None
        item = self.liste_masques.currentItem()
        if item is not None:
            nom_masque = item.data(Qt.UserRole)
            masque_cible = self._trouver_masque(nom_masque)
        if masque_cible is None:
            masque_cible = self._trouver_masque(NOM_MASQUE_IMPORT)
        if masque_cible is None:
            self.afficher_console(
                "[Forme] Aucun masque disponible. Cree un masque d'abord."
            )
            return

        # --- 8. Type origine : SHAPE_<NOM_UPPER_SANS_ESPACE> ---
        type_orig = "SHAPE_" + nom.upper().replace(" ", "_")

        ent = Entite(
            type_origine=type_orig,
            points=points_machine,
            calque=masque_cible.nom,
            couleur_aci=None,
        )

        # --- 9. Item graphique ---
        path = QPainterPath()
        pts_scene = [self.origine_vers_scene(p[0], p[1]) for p in ent.points]
        premier = pts_scene[0]
        path.moveTo(premier.x(), premier.y())
        for p in pts_scene[1:]:
            path.lineTo(p.x(), p.y())

        item_graphique = EntiteItem(ent, path, masque_cible.couleur,
                                    mode_rendu=masque_cible.mode_rendu)
        self.scene.addItem(item_graphique)
        self.items_entites.append(item_graphique)

        # --- 10. Rafraichissement ---
        self._mettre_a_jour_zone_cadrage()
        self._rafraichir_liste_masques()
        self._maj_label_info()

        # --- 11. Log ---
        self.afficher_console(
            f"[Forme] '{nom}' inseree au centre de la zone "
            f"({TAILLE_MM:.0f} mm), masque '{masque_cible.nom}'."
        )

    def changer_mode(self, mode):
        """Appele quand on change de mode depuis la barre de gauche."""
        # A chaque clic sur Polygone, on demande le nombre de cotes.
        # IMPORTANT : on differe l'ouverture du dialog via QTimer.singleShot(0)
        # pour eviter le bug Qt ou le bouton OK ne capte pas le clic souris
        # (le clic sur ⬡ est encore en cours de traitement quand le signal
        # mode_change est emis).
        if mode == "polygone":
            QTimer.singleShot(0, self._ouvrir_dialog_polygone)

        self.mode_actif = mode
        self.view.mode_actif = mode

    def _ouvrir_dialog_polygone(self):
        """Ouvre le dialog de choix du nombre de cotes pour le polygone.
        Appele differe (QTimer.singleShot) pour eviter le bug Qt de clic."""
        nb, ok = QInputDialog.getInt(
            self,
            "Nombre de cotes",
            "Combien de cotes pour le polygone ?",
            self._nb_cotes_polygone,  # defaut = dernier N utilise
            3, 64, 1
        )
        if not ok:
            # Annulation : on revient en mode Selection
            self.barre_gauche._choisir_mode("selection")
            return
        self._nb_cotes_polygone = nb

        if mode == "mesure":
            self.view.setCursor(Qt.CrossCursor)
        elif mode in ("rect", "cercle", "ligne", "polygone"):
            # Modes de trace : curseur croix
            self.view.setCursor(Qt.CrossCursor)
            # On efface une eventuelle mesure en cours
            self.point_a_mesure = None
            self._effacer_item_mesure()
        else:
            self.view.setCursor(Qt.ArrowCursor)
            # On efface une eventuelle mesure en cours
            self.point_a_mesure = None
            self._effacer_item_mesure()

    def revenir_mode_selection(self):
        """Repasse en mode selection (appele par Echap)."""
        self.barre_gauche.btn_selection.setChecked(True)
        self.barre_gauche.btn_mesure.setChecked(False)
        self.barre_gauche._maj_style()
        self.changer_mode("selection")

    def changer_panneau(self, nom):
        """Appele quand on clique sur une icone de la barre de droite."""
        if nom == "aucun":
            self.panneau_contextuel.setVisible(False)
            return

        self.panneau_contextuel.setVisible(True)

        self.panneau_masques.setVisible(nom == "masques")
        self.panneau_transfo.setVisible(nom == "transfo")
        self.panneau_projet.setVisible(nom == "projet")

        if nom == "masques":
            self._rafraichir_liste_masques()
        elif nom == "transfo":
            self._maj_panneau_redim()

    # -------------------------------------------------------------------------
    # Mode mesure
    # -------------------------------------------------------------------------

    def _effacer_item_mesure(self):
        if self.item_mesure is not None:
            if self.item_mesure.scene() is not None:
                self.item_mesure.scene().removeItem(self.item_mesure)
            self.item_mesure = None

    def mesurer_clic(self, point_scene):
        if self.mode_actif != "mesure":
            return

        if self.point_a_mesure is None:
            self.point_a_mesure = point_scene
            self.afficher_console(f"- Mesure : point A en ({point_scene.x():.2f}, {point_scene.y():.2f})")
        else:
            self._effacer_item_mesure()
            self.item_mesure = MesureItem(self.point_a_mesure, point_scene)
            self.scene.addItem(self.item_mesure)
            self.point_a_mesure = None

    # -------------------------------------------------------------------------
    # Regles
    # -------------------------------------------------------------------------

    def _maj_regles(self):
        vue = self.view
        vp = vue.viewport()
        if vp.width() <= 0 or vp.height() <= 0:
            return
        pixels_par_mm = vue.transform().m11()
        if pixels_par_mm <= 0:
            return

        pt_hg = vue.mapToScene(0, 0)
        pt_bd = vue.mapToScene(vp.width(), vp.height())

        sens = self.sens_axes()
        self.regle_h.maj_etat(pixels_par_mm, pt_hg.x(), pt_bd.x(), 0, sens['ex'])
        self.regle_v.maj_etat(pixels_par_mm, pt_hg.y(), pt_bd.y(), 0, sens['ey'])

    # -------------------------------------------------------------------------
    # Sens des axes
    # -------------------------------------------------------------------------

    def sens_axes(self):
        if self.origine_zone == "fond_gauche":
            return {'ex': 1, 'ey': 1}
        elif self.origine_zone == "fond_droit":
            return {'ex': -1, 'ey': 1}
        elif self.origine_zone == "face_gauche":
            return {'ex': 1, 'ey': -1}
        else:
            return {'ex': -1, 'ey': -1}

    def origine_vers_scene(self, x_machine, y_machine):
        sens = self.sens_axes()
        return QPointF(x_machine * sens['ex'], y_machine * sens['ey'])

    # -------------------------------------------------------------------------
    # Zone de travail
    # -------------------------------------------------------------------------

    def appliquer_zone(self):
        self.largeur_zone = self.spin_largeur.value()
        self.hauteur_zone = self.spin_hauteur.value()
        self.mettre_a_jour_zone_travail()
        self._rafraichir_items_depuis_modeles()
        self.recadrer_sur_projet()
        self._maj_regles()

    def changer_origine(self):
        self.origine_zone = self.combo_origine.currentData()
        self.mettre_a_jour_zone_travail()
        self._rafraichir_items_depuis_modeles()
        self._maj_regles()

    def mettre_a_jour_zone_travail(self):
        sens = self.sens_axes()
        L = self.largeur_zone * sens['ex']
        H = self.hauteur_zone * sens['ey']

        x1 = min(0, L); y1 = min(0, H)
        x2 = max(0, L); y2 = max(0, H)
        self.item_zone_travail.setRect(x1, y1, x2 - x1, y2 - y1)

        ox, oy = 0.0, 0.0
        sx, sy = sens['ex'], sens['ey']
        t = TAILLE_FLECHE
        long = LONGUEUR_AXE

        fin_x = ox + long * sx
        path_x = QPainterPath()
        path_x.moveTo(ox, oy)
        path_x.lineTo(fin_x, oy)
        self.item_fleche_x.setPath(path_x)

        pointe_x = QPolygonF([
            QPointF(fin_x, oy),
            QPointF(fin_x - t * sx, oy - t / 2),
            QPointF(fin_x - t * sx, oy + t / 2),
        ])
        self.item_pointe_x.setPolygon(pointe_x)
        self.item_texte_x.setPos(fin_x + 2 * sx, oy - 8)

        fin_y = oy + long * sy
        path_y = QPainterPath()
        path_y.moveTo(ox, oy)
        path_y.lineTo(ox, fin_y)
        self.item_fleche_y.setPath(path_y)

        pointe_y = QPolygonF([
            QPointF(ox, fin_y),
            QPointF(ox - t / 2, fin_y - t * sy),
            QPointF(ox + t / 2, fin_y - t * sy),
        ])
        self.item_pointe_y.setPolygon(pointe_y)
        self.item_texte_y.setPos(ox + 4, fin_y + 2 * sy)

    def _rafraichir_items_depuis_modeles(self):
        for it in self.items_entites:
            ent = it.entite
            path = QPainterPath()
            if not ent.points:
                continue
            pts_scene = [self.origine_vers_scene(p[0], p[1]) for p in ent.points]
            premier = pts_scene[0]
            path.moveTo(premier.x(), premier.y())
            for p in pts_scene[1:]:
                path.lineTo(p.x(), p.y())
            it.setPath(path)
            it.setPos(QPointF(0, 0))

            # Le cadenas doit suivre l'entite
            if hasattr(it, '_cadenas_item') and it._cadenas_item is not None:
                it._cadenas_item.mettre_a_jour_position()

    # -------------------------------------------------------------------------
    # Deplacement
    # -------------------------------------------------------------------------

    def pas_courant(self):
        return self.combo_pas.currentData()

    def _deplacer_via_bouton(self, sx, sy):
        pas = self.pas_courant()
        sens = self.sens_axes()
        self.deplacer_selection(sx * pas * sens['ex'], sy * pas * sens['ey'])

    def deplacer_selection(self, dx, dy):
        selection = [it for it in self.items_entites
                     if it.isSelected() and not it.verrouillee]
        if not selection:
            return
        for it in selection:
            ent = it.entite
            ent.points = [(p[0] + dx, p[1] + dy) for p in ent.points]
        self._rafraichir_items_depuis_modeles()
        self._mettre_a_jour_zone_cadrage()

    def deplacer_selection_par_delta_scene(self, dx_scene, dy_scene, items):
        if not items:
            return
        sens = self.sens_axes()
        dx = dx_scene * sens['ex']
        dy = dy_scene * sens['ey']
        for it in items:
            ent = it.entite
            ent.points = [(p[0] + dx, p[1] + dy) for p in ent.points]
        self._rafraichir_items_depuis_modeles()
        self._mettre_a_jour_zone_cadrage()

    # -------------------------------------------------------------------------
    # Ordre de coupe
    # -------------------------------------------------------------------------

    def monter_masque(self):
        item = self.liste_masques.currentItem()
        if item is None:
            return
        nom = item.data(Qt.UserRole)
        index = next((i for i, m in enumerate(self.masques) if m.nom == nom), -1)
        if index <= 0:
            return
        self.masques[index - 1], self.masques[index] = \
            self.masques[index], self.masques[index - 1]
        self._rafraichir_liste_masques()
        for i in range(self.liste_masques.count()):
            it = self.liste_masques.item(i)
            if it.data(Qt.UserRole) == nom:
                self.liste_masques.setCurrentRow(i)
                break

    def descendre_masque(self):
        item = self.liste_masques.currentItem()
        if item is None:
            return
        nom = item.data(Qt.UserRole)
        index = next((i for i, m in enumerate(self.masques) if m.nom == nom), -1)
        if index < 0 or index >= len(self.masques) - 1:
            return
        self.masques[index + 1], self.masques[index] = \
            self.masques[index], self.masques[index + 1]
        self._rafraichir_liste_masques()
        for i in range(self.liste_masques.count()):
            it = self.liste_masques.item(i)
            if it.data(Qt.UserRole) == nom:
                self.liste_masques.setCurrentRow(i)
                break

    # -------------------------------------------------------------------------
    # Masques
    # -------------------------------------------------------------------------

    def _masque_existe(self, nom):
        return any(m.nom == nom for m in self.masques)

    def _trouver_masque(self, nom):
        for m in self.masques:
            if m.nom == nom:
                return m
        return None

    def _compte_entites_par_masque(self):
        comptes = {}
        for it in self.items_entites:
            nom = it.entite.calque
            comptes[nom] = comptes.get(nom, 0) + 1
        return comptes

    def _rafraichir_liste_masques(self):
        nom_sel = None
        item_cur = self.liste_masques.currentItem()
        if item_cur is not None:
            nom_sel = item_cur.data(Qt.UserRole)

        self.liste_masques.clear()
        comptes = self._compte_entites_par_masque()

        for masque in self.masques:
            n = comptes.get(masque.nom, 0)
            texte = f"{masque.nom}   ({n})"
            item = QListWidgetItem(texte)
            item.setData(Qt.UserRole, masque.nom)

            pixmap = QPixmap(12, 12)
            pixmap.fill(masque.couleur)
            item.setIcon(QIcon(pixmap))
            self.liste_masques.addItem(item)

            if masque.nom == nom_sel:
                self.liste_masques.setCurrentItem(item)

    def creer_masque(self):
        index_nouveau = len(self.masques)
        nom_defaut = f"Masque {index_nouveau + 1}"

        dialogue = DialogueCreationMasque(nom_defaut, self)
        if dialogue.exec() != QDialog.Accepted:
            return

        nom, couleur_hex = dialogue.get_resultat()
        if not nom:
            return
        if self._masque_existe(nom):
            QMessageBox.warning(self, "Doublon", f"Un masque nomme {nom} existe deja.")
            return

        self.masques.append(Masque(nom, couleur_hex))
        self._rafraichir_liste_masques()
        self._maj_label_info()

    def _on_masque_selectionne(self, row):
        if row < 0:
            self.spin_puissance.setValue(0)
            self.spin_vitesse.setValue(0)
            self.spin_passes.setValue(1)
            return
        item = self.liste_masques.item(row)
        if item is None:
            return
        nom = item.data(Qt.UserRole)
        masque = self._trouver_masque(nom)
        if masque is None:
            return

        # --- Charger les parametres LINE (contour) ---
        self.spin_puissance_line.blockSignals(True)
        self.spin_vitesse_line.blockSignals(True)
        self.spin_passes_line.blockSignals(True)
        self.spin_puissance_line.setValue(masque.puissance_line)
        self.spin_vitesse_line.setValue(masque.vitesse_line)
        self.spin_passes_line.setValue(masque.passes_line)
        self.spin_puissance_line.blockSignals(False)
        self.spin_vitesse_line.blockSignals(False)
        self.spin_passes_line.blockSignals(False)

        # --- Charger les parametres FILL (remplissage P/V/N) ---
        self.spin_puissance_fill.blockSignals(True)
        self.spin_vitesse_fill.blockSignals(True)
        self.spin_passes_fill.blockSignals(True)
        self.spin_puissance_fill.setValue(masque.puissance_fill)
        self.spin_vitesse_fill.setValue(masque.vitesse_fill)
        self.spin_passes_fill.setValue(masque.passes_fill)
        self.spin_puissance_fill.blockSignals(False)
        self.spin_vitesse_fill.blockSignals(False)
        self.spin_passes_fill.blockSignals(False)

        # --- Phase Rendu : charger les parametres de mode ---
        self.radio_line.blockSignals(True)
        self.radio_fill.blockSignals(True)
        self.radio_line_fill.blockSignals(True)
        self.spin_espacement_fill.blockSignals(True)
        self.spin_angle_fill.blockSignals(True)
        self.radio_fill_aller.blockSignals(True)
        self.radio_fill_ar.blockSignals(True)

        if masque.mode_rendu == "fill":
            self.radio_fill.setChecked(True)
        elif masque.mode_rendu == "line+fill":
            self.radio_line_fill.setChecked(True)
        else:
            self.radio_line.setChecked(True)

        self.spin_espacement_fill.setValue(masque.espacement_fill)
        self.spin_angle_fill.setValue(masque.angle_fill)
        if masque.sens_fill == "aller":
            self.radio_fill_aller.setChecked(True)
        else:
            self.radio_fill_ar.setChecked(True)

        self.radio_line.blockSignals(False)
        self.radio_fill.blockSignals(False)
        self.radio_line_fill.blockSignals(False)
        self.spin_espacement_fill.blockSignals(False)
        self.spin_angle_fill.blockSignals(False)
        self.radio_fill_aller.blockSignals(False)
        self.radio_fill_ar.blockSignals(False)

        # Visibilite du panneau fill selon le mode
        self.groupe_params_fill.setVisible(
            masque.mode_rendu in ("fill", "line+fill")
        )

        # Visibilite des groupes P/V/N (Line / Fill)
        self.groupe_params_line.setVisible(
            masque.mode_rendu in ("line", "line+fill")
        )
        self.groupe_pvn_fill.setVisible(
            masque.mode_rendu in ("fill", "line+fill")
        )

    def _on_mode_rendu_change(self):
        """Appele quand on change le mode de rendu (Line/Fill/Line+Fill)."""
        item = self.liste_masques.currentItem()
        if item is None:
            return
        nom = item.data(Qt.UserRole)
        masque = self._trouver_masque(nom)
        if masque is None:
            return

        if self.radio_fill.isChecked():
            masque.mode_rendu = "fill"
        elif self.radio_line_fill.isChecked():
            masque.mode_rendu = "line+fill"
        else:
            masque.mode_rendu = "line"

        # Afficher/cacher les parametres de remplissage
        self.groupe_params_fill.setVisible(
            masque.mode_rendu in ("fill", "line+fill")
        )

        # Afficher/cacher les groupes P/V/N (Line / Fill)
        self.groupe_params_line.setVisible(
            masque.mode_rendu in ("line", "line+fill")
        )
        self.groupe_pvn_fill.setVisible(
            masque.mode_rendu in ("fill", "line+fill")
        )

        # Mettre a jour tous les items graphiques lies a ce masque
        for it in self.items_entites:
            if it.entite.calque == nom:
                it.set_mode_rendu(masque.mode_rendu)

        self._maj_label_temps()

    def _on_parametres_fill_modifies(self):
        """Appele quand on change un parametre du remplissage."""
        item = self.liste_masques.currentItem()
        if item is None:
            return
        nom = item.data(Qt.UserRole)
        masque = self._trouver_masque(nom)
        if masque is None:
            return

        masque.espacement_fill = self.spin_espacement_fill.value()
        masque.angle_fill = self.spin_angle_fill.value()
        if self.radio_fill_aller.isChecked():
            masque.sens_fill = "aller"
        else:
            masque.sens_fill = "aller_retour"

        self._maj_label_temps()

    def _on_parametres_line_modifies(self):
        """Appele quand on modifie P/V/N du contour (Line)."""
        item = self.liste_masques.currentItem()
        if item is None:
            return
        nom = item.data(Qt.UserRole)
        masque = self._trouver_masque(nom)
        if masque is None:
            return
        masque.puissance_line = self.spin_puissance_line.value()
        masque.vitesse_line = self.spin_vitesse_line.value()
        masque.passes_line = self.spin_passes_line.value()
        self._maj_label_temps()

    def _on_pvn_fill_modifies(self):
        """Appele quand on modifie P/V/N du remplissage (Fill)."""
        item = self.liste_masques.currentItem()
        if item is None:
            return
        nom = item.data(Qt.UserRole)
        masque = self._trouver_masque(nom)
        if masque is None:
            return
        masque.puissance_fill = self.spin_puissance_fill.value()
        masque.vitesse_fill = self.spin_vitesse_fill.value()
        masque.passes_fill = self.spin_passes_fill.value()
        self._maj_label_temps()

    def _on_parametres_modifies(self):
        item = self.liste_masques.currentItem()
        if item is None:
            return
        nom = item.data(Qt.UserRole)
        masque = self._trouver_masque(nom)
        if masque is None:
            return
        masque.puissance = self.spin_puissance.value()
        masque.vitesse = self.spin_vitesse.value()
        masque.passes = self.spin_passes.value()
        self._maj_label_temps()

    def assigner_au_masque(self):
        item = self.liste_masques.currentItem()
        if item is None:
            QMessageBox.information(self, "Aucun masque", "Selectionnez un masque.")
            return
        nom_masque = item.data(Qt.UserRole)
        masque = self._trouver_masque(nom_masque)
        if masque is None:
            return
        selection = [it for it in self.items_entites if it.isSelected()]
        if not selection:
            QMessageBox.information(self, "Aucune selection", "Selectionnez au moins une entite.")
            return
        for it in selection:
            it.entite.calque = nom_masque
            it.set_couleur(masque.couleur)
        self._rafraichir_liste_masques()
        self._maj_label_info()

    def changer_couleur_masque(self):
        """Ouvre un selecteur de couleur pour modifier la couleur
        du masque actuellement selectionne."""
        from PySide6.QtWidgets import QColorDialog

        item = self.liste_masques.currentItem()
        if item is None:
            self.afficher_console(
                "[Masque] Selectionnez d'abord un masque."
            )
            return

        nom = item.data(Qt.UserRole)
        masque = self._trouver_masque(nom)
        if masque is None:
            return

        couleur = QColorDialog.getColor(
            masque.couleur, self,
            f"Couleur du masque '{masque.nom}'"
        )
        if not couleur.isValid():
            return

        # Appliquer au masque
        masque.couleur = couleur

        # Mettre a jour les items graphiques lies a ce masque
        for it in self.items_entites:
            if it.entite.calque == nom:
                it.set_couleur(couleur)

        # Rafraichir la liste (pastille de couleur)
        self._rafraichir_liste_masques()

        self.afficher_console(
            f"[Masque] Couleur de '{nom}' changee en {couleur.name()}."
        )

    def renommer_masque(self):
        item = self.liste_masques.currentItem()
        if item is None:
            return
        ancien = item.data(Qt.UserRole)
        masque = self._trouver_masque(ancien)
        if masque is None:
            return
        nouveau, ok = QInputDialog.getText(self, "Renommer le masque", "Nouveau nom :", text=ancien)
        if not ok or not nouveau.strip():
            return
        nouveau = nouveau.strip()
        if nouveau == ancien:
            return
        if self._masque_existe(nouveau):
            QMessageBox.warning(self, "Doublon", f"Un masque nomme {nouveau} existe deja.")
            return
        masque.nom = nouveau
        for it in self.items_entites:
            if it.entite.calque == ancien:
                it.entite.calque = nouveau
        self._rafraichir_liste_masques()
        self._maj_label_info()

    def supprimer_masque(self):
        item = self.liste_masques.currentItem()
        if item is None:
            return
        nom = item.data(Qt.UserRole)
        masque = self._trouver_masque(nom)
        if masque is None:
            return
        n_ent = sum(1 for it in self.items_entites if it.entite.calque == nom)
        if n_ent > 0:
            message = f"Supprimer le masque {nom} ?\n\n{n_ent} entite(s) seront reassignees a Import."
        else:
            message = f"Supprimer le masque {nom} ?"
        rep = QMessageBox.question(self, "Confirmer", message, QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
        if rep != QMessageBox.Yes:
            return
        if n_ent > 0 and not self._masque_existe(NOM_MASQUE_IMPORT):
            self.masques.append(Masque(NOM_MASQUE_IMPORT, COULEUR_IMPORT))
        masque_import = self._trouver_masque(NOM_MASQUE_IMPORT)
        for it in self.items_entites:
            if it.entite.calque == nom:
                it.entite.calque = NOM_MASQUE_IMPORT
                if masque_import is not None:
                    it.set_couleur(masque_import.couleur)
        self.masques = [m for m in self.masques if m.nom != nom]
        self._rafraichir_liste_masques()
        self._maj_label_info()

    # -------------------------------------------------------------------------
    # Chargement DXF
    # -------------------------------------------------------------------------

    def charger_dxf(self):
        chemin, _ = QFileDialog.getOpenFileName(
            self, "Choisir un fichier DXF", "",
            "Fichiers DXF (*.dxf);;Tous les fichiers (*.*)"
        )
        if not chemin:
            return
        try:
            from src.core.dxf_loader import charger_dxf
        except ImportError as e:
            QMessageBox.critical(self, "Erreur", f"Impossible d'importer le lecteur DXF :\n{e}")
            return
        try:
            entites, warnings = charger_dxf(chemin)
        except Exception as e:
            QMessageBox.critical(self, "Erreur de lecture DXF", f"Impossible de lire le fichier :\n{e}")
            return
        self.ajouter_entites(entites, warnings)
        nom = os.path.basename(chemin)
        self.label_info.setText(f"{nom} ajoute - {len(self.items_entites)} entite(s) au total")

    def ajouter_entites(self, entites, warnings=None):
        if not self._masque_existe(NOM_MASQUE_IMPORT):
            self.masques.append(Masque(NOM_MASQUE_IMPORT, COULEUR_IMPORT))
        for ent in entites:
            ent.calque = NOM_MASQUE_IMPORT
        couleurs = {m.nom: m.couleur for m in self.masques}

        zone_totale = QRectF()
        for ent in entites:
            path = QPainterPath()
            if not ent.points:
                continue
            pts_scene = [self.origine_vers_scene(p[0], p[1]) for p in ent.points]
            premier = pts_scene[0]
            path.moveTo(premier.x(), premier.y())
            for p in pts_scene[1:]:
                path.lineTo(p.x(), p.y())
            couleur = couleurs.get(ent.calque, QColor("#000000"))
            _masque_li = self._trouver_masque(ent.calque)
            _mode_li = _masque_li.mode_rendu if _masque_li else "line"
            item = EntiteItem(ent, path, couleur, mode_rendu=_mode_li)
            self.scene.addItem(item)
            self.items_entites.append(item)
            r = path.boundingRect()
            zone_totale = zone_totale.united(r) if not zone_totale.isNull() else r

        self._mettre_a_jour_zone_cadrage()
        if not zone_totale.isNull() and not zone_totale.isEmpty():
            self._cadrer_sur_zone(zone_totale)
        else:
            QTimer.singleShot(0, self.recadrer_sur_projet)
        QTimer.singleShot(50, self._maj_regles)
        self._rafraichir_liste_masques()
        self._maj_label_info()
        if warnings:
            QMessageBox.information(self, "Chargement termine avec avertissements", "\n".join(warnings))

    # -------------------------------------------------------------------------
    # Vider le projet
    # -------------------------------------------------------------------------

    def vider_projet(self):
        rep = QMessageBox.question(
            self, "Vider le projet",
            "Vider tout le projet ?\n\nEntites, masques, zone et origine seront remis a zero.",
            QMessageBox.Yes | QMessageBox.No, QMessageBox.No
        )
        if rep != QMessageBox.Yes:
            return
        for item in self.items_entites:
            self.scene.removeItem(item)
        self.items_entites = []
        self.masques = []

        self.largeur_zone = ZONE_DEFAUT_LARGEUR
        self.hauteur_zone = ZONE_DEFAUT_HAUTEUR
        self.spin_largeur.blockSignals(True)
        self.spin_hauteur.blockSignals(True)
        self.spin_largeur.setValue(ZONE_DEFAUT_LARGEUR)
        self.spin_hauteur.setValue(ZONE_DEFAUT_HAUTEUR)
        self.spin_largeur.blockSignals(False)
        self.spin_hauteur.blockSignals(False)

        self.origine_zone = ORIGINE_DEFAUT
        self.combo_origine.blockSignals(True)
        for idx, (_, cle) in enumerate(ORIGINES_DISPONIBLES):
            if cle == ORIGINE_DEFAUT:
                self.combo_origine.setCurrentIndex(idx)
                break
        self.combo_origine.blockSignals(False)

        self.mettre_a_jour_zone_travail()
        self._rafraichir_liste_masques()
        self.label_info.setText("Projet vide")
        self._maj_label_info()
        self.zone_projet = QRectF()
        self.recadrer_sur_projet()
        QTimer.singleShot(50, self._maj_regles)

    # -------------------------------------------------------------------------
    # Cadrage
    # -------------------------------------------------------------------------

    def _mettre_a_jour_zone_cadrage(self, zone_totale=None):
        sens = self.sens_axes()
        L = self.largeur_zone * sens['ex']
        H = self.hauteur_zone * sens['ey']
        zone_zone = QRectF(min(0, L), min(0, H), abs(L), abs(H))

        if zone_totale is None:
            zone_totale = QRectF()
            for it in self.items_entites:
                r = it.boundingRect()
                zone_totale = zone_totale.united(r) if not zone_totale.isNull() else r

        if zone_totale.isNull() or zone_totale.isEmpty():
            zone_finale = zone_zone
        else:
            zone_finale = zone_totale.united(zone_zone)

        mx = max(zone_finale.width(), 1.0) * MARGE_VUE
        my = max(zone_finale.height(), 1.0) * MARGE_VUE
        zone_finale.adjust(-mx, -my, mx, my)
        self.zone_projet = zone_finale

        centre = self.zone_projet.center()
        larg = max(self.zone_projet.width(), 1.0) * FACTEUR_ELARGISSEMENT_SCENE
        haut = max(self.zone_projet.height(), 1.0) * FACTEUR_ELARGISSEMENT_SCENE
        self.scene.setSceneRect(QRectF(centre.x() - larg / 2, centre.y() - haut / 2, larg, haut))

    def _cadrer_sur_zone(self, zone):
        mx = max(zone.width(), 1.0) * 0.10
        my = max(zone.height(), 1.0) * 0.10
        cible = QRectF(zone)
        cible.adjust(-mx, -my, mx, my)
        self.view.viewport().update()
        self.scene.update()
        self.view.fitInView(cible, Qt.KeepAspectRatio)
        QTimer.singleShot(50, self._maj_regles)

    def recadrer_sur_projet(self):
        sens = self.sens_axes()
        L = self.largeur_zone * sens['ex']
        H = self.hauteur_zone * sens['ey']
        zone_zone = QRectF(min(0, L), min(0, H), abs(L), abs(H))
        cible = self.zone_projet if not (self.zone_projet.isNull() or self.zone_projet.isEmpty()) else zone_zone
        mx = max(cible.width(), 1.0) * 0.05
        my = max(cible.height(), 1.0) * 0.05
        cible = QRectF(cible)
        cible.adjust(-mx, -my, mx, my)
        self.view.viewport().update()
        self.scene.update()
        self.view.fitInView(cible, Qt.KeepAspectRatio)
        QTimer.singleShot(50, self._maj_regles)

    # -------------------------------------------------------------------------
    # Suppression
    # -------------------------------------------------------------------------

    def supprimer_selection(self):
        selection = [it for it in self.items_entites
                     if it.isSelected() and not it.verrouillee]
        n = len(selection)
        if n == 0:
            QMessageBox.information(self, "Rien a supprimer",
                                    "Aucune entite non verrouillee selectionnee.")
            return
        rep = QMessageBox.question(
            self, "Confirmer la suppression",
            f"Supprimer {n} entite(s) ?\n\nCette action ne peut pas etre annulee.",
            QMessageBox.Yes | QMessageBox.No, QMessageBox.No
        )
        if rep != QMessageBox.Yes:
            return
        for it in selection:
            self.scene.removeItem(it)
            if it in self.items_entites:
                self.items_entites.remove(it)
        masques_util = set(it.entite.calque for it in self.items_entites)
        self.masques = [m for m in self.masques if m.nom in masques_util]
        self._mettre_a_jour_zone_cadrage()
        self._rafraichir_liste_masques()
        self._maj_label_info()

    # -------------------------------------------------------------------------
    # Labels
    # -------------------------------------------------------------------------

    def _maj_label_info(self):
        n = len(self.items_entites)
        n_masques = len(self.masques)
        if n == 0:
            self.label_info.setText(f"Aucune entite - {n_masques} masque(s)")
        else:
            self.label_info.setText(f"{n} entite(s) - {n_masques} masque(s)")
        self._maj_label_temps()

    def _maj_label_temps(self):
        if not self.items_entites or not self.masques:
            self.label_temps.setText("")
            return
        try:
            from src.core.generateur_gcode import generer_gcode
            from src.core.estimateur_temps import estimer_temps_gcode, formater_temps
            entites = [it.entite for it in self.items_entites]
            lignes = generer_gcode(masques=self.masques, entites=entites,
                                   s_max=1000, graver_ouvertes=True)
            s = estimer_temps_gcode(lignes)
            self.label_temps.setText(f"Temps estime : {formater_temps(s)}")
        except Exception:
            self.label_temps.setText("")

    # -------------------------------------------------------------------------
    # Panneau transformations
    # -------------------------------------------------------------------------

    def _maj_panneau_redim(self):
        selection = [it for it in self.items_entites if it.isSelected()]

        if not selection:
            self.label_selection_info.setText("Aucune selection")
            for w in (self.spin_largeur_cible, self.spin_hauteur_cible,
                      self.check_verrou, self.btn_appliquer_redim,
                      self.spin_pos_x, self.spin_pos_y, self.btn_appliquer_pos,
                      self.btn_rot_90, self.btn_rot_180, self.btn_rot_270,
                      self.spin_angle, self.btn_rot_libre,
                      self.btn_miroir_h, self.btn_miroir_v):
                w.setEnabled(False)
            return

        x_min, y_min, x_max, y_max = self._bbox_selection(selection)
        largeur = x_max - x_min
        hauteur = y_max - y_min

        self.label_selection_info.setText(
            f"{len(selection)} entite(s)\n"
            f"X: {x_min:.2f} -> {x_max:.2f}\n"
            f"Y: {y_min:.2f} -> {y_max:.2f}"
        )

        self.spin_largeur_cible.blockSignals(True)
        self.spin_hauteur_cible.blockSignals(True)
        self.spin_largeur_cible.setValue(max(largeur, 0.1))
        self.spin_hauteur_cible.setValue(max(hauteur, 0.1))
        self.spin_largeur_cible.blockSignals(False)
        self.spin_hauteur_cible.blockSignals(False)

        self.spin_pos_x.blockSignals(True)
        self.spin_pos_y.blockSignals(True)
        self.spin_pos_x.setValue(x_min)
        self.spin_pos_y.setValue(y_min)
        self.spin_pos_x.blockSignals(False)
        self.spin_pos_y.blockSignals(False)

        for w in (self.spin_largeur_cible, self.spin_hauteur_cible,
                  self.check_verrou, self.btn_appliquer_redim,
                  self.spin_pos_x, self.spin_pos_y, self.btn_appliquer_pos,
                  self.btn_rot_90, self.btn_rot_180, self.btn_rot_270,
                  self.spin_angle, self.btn_rot_libre,
                  self.btn_miroir_h, self.btn_miroir_v):
            w.setEnabled(True)

    def _on_largeur_cible_changee(self, valeur):
        if not self.check_verrou.isChecked():
            return
        selection = [it for it in self.items_entites if it.isSelected()]
        if not selection:
            return
        x_min, y_min, x_max, y_max = self._bbox_selection(selection)
        la = x_max - x_min
        ha = y_max - y_min
        if la < 1e-9:
            return
        ratio = ha / la
        self.spin_hauteur_cible.blockSignals(True)
        self.spin_hauteur_cible.setValue(max(valeur * ratio, 0.1))
        self.spin_hauteur_cible.blockSignals(False)

    def _on_hauteur_cible_changee(self, valeur):
        if not self.check_verrou.isChecked():
            return
        selection = [it for it in self.items_entites if it.isSelected()]
        if not selection:
            return
        x_min, y_min, x_max, y_max = self._bbox_selection(selection)
        la = x_max - x_min
        ha = y_max - y_min
        if ha < 1e-9:
            return
        ratio = la / ha
        self.spin_largeur_cible.blockSignals(True)
        self.spin_largeur_cible.setValue(max(valeur * ratio, 0.1))
        self.spin_largeur_cible.blockSignals(False)

    def _bbox_selection(self, selection):
        x_min = y_min = x_max = y_max = None
        for it in selection:
            for (x, y) in it.entite.points:
                if x_min is None or x < x_min: x_min = x
                if x_max is None or x > x_max: x_max = x
                if y_min is None or y < y_min: y_min = y
                if y_max is None or y > y_max: y_max = y
        return x_min, y_min, x_max, y_max

    def appliquer_redimensionnement(self):
        selection = [it for it in self.items_entites
                     if it.isSelected() and not it.verrouillee]
        if not selection:
            QMessageBox.information(self, "Aucune entite",
                                    "Aucune entite non verrouillee selectionnee.")
            return
        x_min, y_min, x_max, y_max = self._bbox_selection(selection)
        la = x_max - x_min
        ha = y_max - y_min
        if la < 1e-9 or ha < 1e-9:
            QMessageBox.warning(self, "Impossible", "Selection trop petite.")
            return
        nl = self.spin_largeur_cible.value()
        nh = self.spin_hauteur_cible.value()
        if nl <= 0 or nh <= 0:
            QMessageBox.warning(self, "Valeurs invalides", "Largeur et hauteur > 0.")
            return
        fx = nl / la
        fy = nh / ha
        cx = (x_min + x_max) / 2
        cy = (y_min + y_max) / 2
        for it in selection:
            ent = it.entite
            ent.points = [(cx + (x - cx) * fx, cy + (y - cy) * fy) for (x, y) in ent.points]
        self._rafraichir_items_depuis_modeles()
        self._mettre_a_jour_zone_cadrage()
        self._maj_panneau_redim()
        self._maj_regles()

    def appliquer_positionnement(self):
        selection = [it for it in self.items_entites
                     if it.isSelected() and not it.verrouillee]
        if not selection:
            QMessageBox.information(self, "Aucune entite",
                                    "Aucune entite non verrouillee selectionnee.")
            return
        x_min, y_min, _, _ = self._bbox_selection(selection)
        dx = self.spin_pos_x.value() - x_min
        dy = self.spin_pos_y.value() - y_min
        for it in selection:
            ent = it.entite
            ent.points = [(p[0] + dx, p[1] + dy) for p in ent.points]
        self._rafraichir_items_depuis_modeles()
        self._mettre_a_jour_zone_cadrage()
        self._maj_panneau_redim()
        self._maj_regles()

    # -------------------------------------------------------------------------
    # Trace de primitives
    # -------------------------------------------------------------------------

    def finaliser_trace_primitive(self, mode, p1_scene, p2_scene):
        """
        Appelee par VueMiseEnPage quand un trace clic-glisser se termine.
        Dispatch selon le mode :
          - "rect" : cree un rectangle
          (les autres modes seront ajoutes dans les sous-etapes suivantes)
        """
        if mode == "rect":
            self.creer_rectangle_depuis_scene(p1_scene, p2_scene)
        elif mode == "cercle":
            from PySide6.QtWidgets import QApplication
            shift = bool(QApplication.keyboardModifiers() & Qt.ShiftModifier)
            self.creer_cercle_depuis_scene(p1_scene, p2_scene, ellipse=shift)
        elif mode == "ligne":
            from PySide6.QtWidgets import QApplication
            import math as _math
            shift = bool(QApplication.keyboardModifiers() & Qt.ShiftModifier)
            if shift:
                dx = p2_scene.x() - p1_scene.x()
                dy = p2_scene.y() - p1_scene.y()
                angle = _math.atan2(dy, dx)
                pas = _math.pi / 4.0
                angle_arrondi = round(angle / pas) * pas
                longueur = _math.hypot(dx, dy)
                p2_scene = QPointF(
                    p1_scene.x() + longueur * _math.cos(angle_arrondi),
                    p1_scene.y() + longueur * _math.sin(angle_arrondi)
                )
            self.creer_ligne_depuis_scene(p1_scene, p2_scene)
        elif mode == "polygone":
            from PySide6.QtWidgets import QApplication
            shift = bool(QApplication.keyboardModifiers() & Qt.ShiftModifier)
            nb = getattr(self, "_nb_cotes_polygone", 6)
            self.creer_polygone_depuis_scene(p1_scene, p2_scene, nb, shift)
        if self.barre_gauche is not None:
            self.barre_gauche._choisir_mode("selection")

    def creer_polygone_depuis_scene(self, p1_scene, p2_scene, nb_cotes, shift=False):
        """
        Cree un polygone regulier a nb_cotes, inscrit dans un cercle
        dont le diametre = min(|dx|,|dy|) du drag.
        Orientation standard CAO (N impair -> sommet vers le haut,
        N pair -> arete horizontale en haut) ; Shift -> orientation snappee.
        """
        import math as _math
        from src.core.dxf_loader import Entite

        if nb_cotes < 3:
            nb_cotes = 3

        # --- 1. Calcul du diametre / centre (scene) ---
        dx = abs(p2_scene.x() - p1_scene.x())
        dy = abs(p2_scene.y() - p1_scene.y())
        diametre_s = min(dx, dy)

        if diametre_s < 0.5:
            self.afficher_console("[Polygone] Trop petit, ignore.")
            return

        rayon_s = diametre_s / 2.0

        # Centre
        if p2_scene.x() >= p1_scene.x():
            cx_s = p1_scene.x() + rayon_s
        else:
            cx_s = p1_scene.x() - rayon_s
        if p2_scene.y() >= p1_scene.y():
            cy_s = p1_scene.y() + rayon_s
        else:
            cy_s = p1_scene.y() - rayon_s

        # --- 2. Passage scene -> machine ---
        sens = self.sens_axes()
        cx_m = cx_s / sens['ex']
        cy_m = cy_s / sens['ey']
        rayon_m = rayon_s / abs(sens['ex'])

        # --- 3. Orientation ---
        if nb_cotes % 2 == 1:
            angle_depart = -_math.pi / 2.0
        else:
            angle_depart = -_math.pi / 2.0 + _math.pi / nb_cotes

        if shift:
            dxd = p2_scene.x() - p1_scene.x()
            dyd = p2_scene.y() - p1_scene.y()
            angle_drag = _math.atan2(dyd, dxd)
            pas = _math.pi / 4.0
            angle_drag_snap = round(angle_drag / pas) * pas
            angle_depart += angle_drag_snap

        # --- 4. Points du polygone (machine) ---
        points_machine = []
        for i in range(nb_cotes):
            a = angle_depart + 2.0 * _math.pi * i / nb_cotes
            px = cx_m + rayon_m * _math.cos(a)
            py = cy_m + rayon_m * _math.sin(a)
            points_machine.append((px, py))
        # Fermeture
        points_machine.append(points_machine[0])

        # --- 5. Verification depassement ---
        lz = float(self.largeur_zone)
        hz = float(self.hauteur_zone)
        bb_x_min = min(p[0] for p in points_machine)
        bb_y_min = min(p[1] for p in points_machine)
        bb_x_max = max(p[0] for p in points_machine)
        bb_y_max = max(p[1] for p in points_machine)
        if (bb_x_max > lz) or (bb_y_max > hz) or (bb_x_min < 0) or (bb_y_min < 0):
            self.afficher_console(
                f"[Polygone] ATTENTION : depasse la zone "
                f"({lz:.1f} x {hz:.1f} mm). Cree quand meme."
            )

        # --- 6. Choix du masque ---
        masque_cible = None
        item = self.liste_masques.currentItem()
        if item is not None:
            nom_masque = item.data(Qt.UserRole)
            masque_cible = self._trouver_masque(nom_masque)
        if masque_cible is None:
            masque_cible = self._trouver_masque(NOM_MASQUE_IMPORT)
        if masque_cible is None:
            self.afficher_console(
                "[Polygone] Aucun masque disponible. Cree un masque d'abord."
            )
            return

        # --- 7. Creation de l'Entite ---
        ent = Entite(
            type_origine="POLYGON",
            points=points_machine,
            calque=masque_cible.nom,
            couleur_aci=None,
        )

        # --- 8. Item graphique ---
        path = QPainterPath()
        pts_scene = [self.origine_vers_scene(p[0], p[1]) for p in ent.points]
        premier = pts_scene[0]
        path.moveTo(premier.x(), premier.y())
        for p in pts_scene[1:]:
            path.lineTo(p.x(), p.y())

        item_graphique = EntiteItem(ent, path, masque_cible.couleur,
                                    mode_rendu=masque_cible.mode_rendu)
        self.scene.addItem(item_graphique)
        self.items_entites.append(item_graphique)

        # --- 9. Rafraichissement ---
        self._mettre_a_jour_zone_cadrage()
        self._rafraichir_liste_masques()
        self._maj_label_info()

        # --- 10. Log ---
        diametre_mm = diametre_s / abs(sens['ex'])
        self.afficher_console(
            f"[Polygone] Cree : {nb_cotes} cotes, diametre {diametre_mm:.1f} mm "
            f"(centre {cx_m:.1f}, {cy_m:.1f}), masque '{masque_cible.nom}'."
        )

    def creer_ligne_depuis_scene(self, p1_scene, p2_scene):
        """
        Cree une ligne a partir de 2 points en scene.
        Convertit en coordonnees MACHINE, cree une Entite, l'ajoute au projet.
        """
        import math as _math
        from src.core.dxf_loader import Entite

        # --- 1. Passage scene -> machine ---
        sens = self.sens_axes()
        x1_m = p1_scene.x() / sens['ex']
        y1_m = p1_scene.y() / sens['ey']
        x2_m = p2_scene.x() / sens['ex']
        y2_m = p2_scene.y() / sens['ey']

        # --- 2. Verification longueur mini ---
        longueur = _math.hypot(x2_m - x1_m, y2_m - y1_m)
        if longueur < 0.1:
            self.afficher_console("[Ligne] Trop courte, ignoree.")
            return

        # --- 3. Points de la ligne ---
        points_machine = [(x1_m, y1_m), (x2_m, y2_m)]

        # --- 4. Verification depassement ---
        lz = float(self.largeur_zone)
        hz = float(self.hauteur_zone)
        x_min = min(x1_m, x2_m)
        x_max = max(x1_m, x2_m)
        y_min = min(y1_m, y2_m)
        y_max = max(y1_m, y2_m)
        if (x_max > lz) or (y_max > hz) or (x_min < 0) or (y_min < 0):
            self.afficher_console(
                f"[Ligne] ATTENTION : depasse la zone "
                f"({lz:.1f} x {hz:.1f} mm). Cree quand meme."
            )

        # --- 5. Choix du masque ---
        masque_cible = None
        item = self.liste_masques.currentItem()
        if item is not None:
            nom_masque = item.data(Qt.UserRole)
            masque_cible = self._trouver_masque(nom_masque)
        if masque_cible is None:
            masque_cible = self._trouver_masque(NOM_MASQUE_IMPORT)
        if masque_cible is None:
            self.afficher_console(
                "[Ligne] Aucun masque disponible. Cree un masque d'abord."
            )
            return

        # --- 6. Creation de l'Entite ---
        ent = Entite(
            type_origine="LINE",
            points=points_machine,
            calque=masque_cible.nom,
            couleur_aci=None,
        )

        # --- 7. Item graphique ---
        path = QPainterPath()
        pts_scene = [self.origine_vers_scene(p[0], p[1]) for p in ent.points]
        premier = pts_scene[0]
        path.moveTo(premier.x(), premier.y())
        for p in pts_scene[1:]:
            path.lineTo(p.x(), p.y())

        item_graphique = EntiteItem(ent, path, masque_cible.couleur,
                                    mode_rendu=masque_cible.mode_rendu)
        self.scene.addItem(item_graphique)
        self.items_entites.append(item_graphique)

        # --- 8. Rafraichissement ---
        self._mettre_a_jour_zone_cadrage()
        self._rafraichir_liste_masques()
        self._maj_label_info()

        # --- 9. Log ---
        self.afficher_console(
            f"[Ligne] Creee : longueur {longueur:.1f} mm, "
            f"de ({x1_m:.1f}, {y1_m:.1f}) a ({x2_m:.1f}, {y2_m:.1f}), "
            f"masque '{masque_cible.nom}'."
        )

    def creer_cercle_depuis_scene(self, p1_scene, p2_scene, ellipse=False):
        """
        Cree un cercle (parfait) ou une ellipse a partir de 2 coins en scene.
        - ellipse=False : cercle parfait (rayon = min(dx, dy) / 2)
        - ellipse=True  : ellipse libre (bounding box du drag)
        Convertit en coordonnees MACHINE, cree une Entite, l'ajoute au projet.
        """
        import math as _math
        from src.core.dxf_loader import Entite

        # --- 1. Bornes du rectangle englobant (scene) ---
        x_min_s = min(p1_scene.x(), p2_scene.x())
        x_max_s = max(p1_scene.x(), p2_scene.x())
        y_min_s = min(p1_scene.y(), p2_scene.y())
        y_max_s = max(p1_scene.y(), p2_scene.y())

        largeur_s = x_max_s - x_min_s
        hauteur_s = y_max_s - y_min_s

        if largeur_s < 0.5 or hauteur_s < 0.5:
            self.afficher_console(
                "[Cercle] Trop petit, ignore."
            )
            return

        # --- 2. Si cercle parfait : on egalise les 2 dimensions ---
        if not ellipse:
            cote = min(largeur_s, hauteur_s)
            # On recadre le carre en haut-gauche de la bbox
            x_max_s = x_min_s + cote
            y_max_s = y_min_s + cote
            largeur_s = cote
            hauteur_s = cote

        # --- 3. Passage scene -> machine ---
        sens = self.sens_axes()
        cx_s = (x_min_s + x_max_s) / 2.0
        cy_s = (y_min_s + y_max_s) / 2.0
        rx_s = largeur_s / 2.0
        ry_s = hauteur_s / 2.0

        # Conversion : on divise par le sens des axes (ex/ey valent ±1)
        cx_m = cx_s / sens['ex']
        cy_m = cy_s / sens['ey']
        rx_m = rx_s / abs(sens['ex'])
        ry_m = ry_s / abs(sens['ey'])

        # --- 4. Generation des points (64 segments) ---
        NB_SEGMENTS = 64
        points_machine = []
        for i in range(NB_SEGMENTS):
            angle = 2.0 * _math.pi * i / NB_SEGMENTS
            px = cx_m + rx_m * _math.cos(angle)
            py = cy_m + ry_m * _math.sin(angle)
            points_machine.append((px, py))
        # Fermeture explicite
        points_machine.append(points_machine[0])

        # --- 5. Verification depassement ---
        lz = float(self.largeur_zone)
        hz = float(self.hauteur_zone)
        # bbox machine (axe aligne)
        bb_x_min = min(p[0] for p in points_machine)
        bb_y_min = min(p[1] for p in points_machine)
        bb_x_max = max(p[0] for p in points_machine)
        bb_y_max = max(p[1] for p in points_machine)
        if (bb_x_max > lz) or (bb_y_max > hz) or (bb_x_min < 0) or (bb_y_min < 0):
            self.afficher_console(
                f"[Cercle] ATTENTION : depasse la zone "
                f"({lz:.1f} x {hz:.1f} mm). Cree quand meme."
            )

        # --- 6. Choix du masque ---
        masque_cible = None
        item = self.liste_masques.currentItem()
        if item is not None:
            nom_masque = item.data(Qt.UserRole)
            masque_cible = self._trouver_masque(nom_masque)
        if masque_cible is None:
            masque_cible = self._trouver_masque(NOM_MASQUE_IMPORT)
        if masque_cible is None:
            self.afficher_console(
                "[Cercle] Aucun masque disponible. Cree un masque d'abord."
            )
            return

        # --- 7. Creation de l'Entite ---
        type_orig = "ELLIPSE" if ellipse else "CIRCLE"
        ent = Entite(
            type_origine=type_orig,
            points=points_machine,
            calque=masque_cible.nom,
            couleur_aci=None,
        )

        # --- 8. Item graphique ---
        path = QPainterPath()
        pts_scene = [self.origine_vers_scene(p[0], p[1]) for p in ent.points]
        premier = pts_scene[0]
        path.moveTo(premier.x(), premier.y())
        for p in pts_scene[1:]:
            path.lineTo(p.x(), p.y())

        item_graphique = EntiteItem(ent, path, masque_cible.couleur,
                                    mode_rendu=masque_cible.mode_rendu)
        self.scene.addItem(item_graphique)
        self.items_entites.append(item_graphique)

        # --- 9. Rafraichissement ---
        self._mettre_a_jour_zone_cadrage()
        self._rafraichir_liste_masques()
        self._maj_label_info()

        # --- 10. Log ---
        if ellipse:
            self.afficher_console(
                f"[Ellipse] Creee : {largeur_s / abs(sens['ex']):.1f} x "
                f"{hauteur_s / abs(sens['ey']):.1f} mm "
                f"(centre {cx_m:.1f}, {cy_m:.1f}), masque '{masque_cible.nom}'."
            )
        else:
            diametre = largeur_s / abs(sens['ex'])
            self.afficher_console(
                f"[Cercle] Cree : diametre {diametre:.1f} mm "
                f"(centre {cx_m:.1f}, {cy_m:.1f}), masque '{masque_cible.nom}'."
            )

    def creer_rectangle_depuis_scene(self, p1_scene, p2_scene):
        """
        Cree un rectangle a partir de 2 coins en coordonnees SCENE.
        Convertit en coordonnees MACHINE, cree une Entite, l'ajoute au projet.
        """
        from src.core.dxf_loader import Entite

        # --- 1. Passage scene -> machine ---
        sens = self.sens_axes()
        x1_m = p1_scene.x() / sens['ex']
        y1_m = p1_scene.y() / sens['ey']
        x2_m = p2_scene.x() / sens['ex']
        y2_m = p2_scene.y() / sens['ey']

        # --- 2. Normalisation (rectangle droit) ---
        x_min = min(x1_m, x2_m)
        y_min = min(y1_m, y2_m)
        x_max = max(x1_m, x2_m)
        y_max = max(y1_m, y2_m)

        # Taille mini (eviter rectangles degeneres sur clic sec)
        if (x_max - x_min) < 0.1 or (y_max - y_min) < 0.1:
            self.afficher_console(
                "[Rectangle] Trop petit, ignore."
            )
            return

        # --- 3. Verification depassement ---
        lz = float(self.largeur_zone)
        hz = float(self.hauteur_zone)
        if (x_max > lz) or (y_max > hz) or (x_min < 0) or (y_min < 0):
            self.afficher_console(
                f"[Rectangle] ATTENTION : depasse la zone "
                f"({lz:.1f} x {hz:.1f} mm). Cree quand meme."
            )

        # --- 4. Choix du masque ---
        masque_cible = None
        item = self.liste_masques.currentItem()
        if item is not None:
            nom_masque = item.data(Qt.UserRole)
            masque_cible = self._trouver_masque(nom_masque)
        if masque_cible is None:
            masque_cible = self._trouver_masque(NOM_MASQUE_IMPORT)
        if masque_cible is None:
            self.afficher_console(
                "[Rectangle] Aucun masque disponible. Cree un masque d'abord."
            )
            return

        # --- 5. Points du rectangle (ferme) ---
        points_machine = [
            (x_min, y_min),
            (x_max, y_min),
            (x_max, y_max),
            (x_min, y_max),
            (x_min, y_min),
        ]

        # --- 6. Creation de l'Entite ---
        ent = Entite(
            type_origine="RECT",
            points=points_machine,
            calque=masque_cible.nom,
            couleur_aci=None,
        )

        # --- 7. Item graphique ---
        path = QPainterPath()
        pts_scene = [self.origine_vers_scene(p[0], p[1]) for p in ent.points]
        premier = pts_scene[0]
        path.moveTo(premier.x(), premier.y())
        for p in pts_scene[1:]:
            path.lineTo(p.x(), p.y())

        item_graphique = EntiteItem(ent, path, masque_cible.couleur,
                                    mode_rendu=masque_cible.mode_rendu)
        self.scene.addItem(item_graphique)
        self.items_entites.append(item_graphique)

        # --- 8. Rafraichissement ---
        self._mettre_a_jour_zone_cadrage()
        self._rafraichir_liste_masques()
        self._maj_label_info()

        # --- 9. Log ---
        largeur = x_max - x_min
        hauteur = y_max - y_min
        self.afficher_console(
            f"[Rectangle] Cree : {largeur:.1f} x {hauteur:.1f} mm "
            f"a ({x_min:.1f}, {y_min:.1f}), masque '{masque_cible.nom}'."
        )

    def appliquer_rotation(self, angle_deg):
        selection = [it for it in self.items_entites
                     if it.isSelected() and not it.verrouillee]
        if not selection:
            QMessageBox.information(self, "Aucune entite",
                                    "Aucune entite non verrouillee selectionnee.")
            return
        x_min, y_min, x_max, y_max = self._bbox_selection(selection)
        cx = (x_min + x_max) / 2
        cy = (y_min + y_max) / 2
        a = math.radians(angle_deg)
        ca, sa = math.cos(a), math.sin(a)
        for it in selection:
            ent = it.entite
            nouveaux = []
            for (x, y) in ent.points:
                dx, dy = x - cx, y - cy
                nouveaux.append((dx * ca - dy * sa + cx, dx * sa + dy * ca + cy))
            ent.points = nouveaux
        self._rafraichir_items_depuis_modeles()
        self._mettre_a_jour_zone_cadrage()
        self._maj_panneau_redim()
        self._maj_regles()

    def appliquer_miroir_horizontal(self):
        selection = [it for it in self.items_entites
                     if it.isSelected() and not it.verrouillee]
        if not selection:
            QMessageBox.information(self, "Aucune entite",
                                    "Aucune entite non verrouillee selectionnee.")
            return
        x_min, _, x_max, _ = self._bbox_selection(selection)
        cx = (x_min + x_max) / 2
        for it in selection:
            ent = it.entite
            ent.points = [(2 * cx - x, y) for (x, y) in ent.points]
        self._rafraichir_items_depuis_modeles()
        self._mettre_a_jour_zone_cadrage()
        self._maj_regles()

    def appliquer_miroir_vertical(self):
        selection = [it for it in self.items_entites
                     if it.isSelected() and not it.verrouillee]
        if not selection:
            QMessageBox.information(self, "Aucune entite",
                                    "Aucune entite non verrouillee selectionnee.")
            return
        _, y_min, _, y_max = self._bbox_selection(selection)
        cy = (y_min + y_max) / 2
        for it in selection:
            ent = it.entite
            ent.points = [(x, 2 * cy - y) for (x, y) in ent.points]
        self._rafraichir_items_depuis_modeles()
        self._mettre_a_jour_zone_cadrage()
        self._maj_regles()

    # -------------------------------------------------------------------------
    # G-code
    # -------------------------------------------------------------------------

    def generer_gcode_action(self):
        """
        Genere le G-code depuis le projet.

        Ouvre UNE SEULE popup avec toutes les options :
          - Graver uniquement la selection
          - Graver les polylignes ouvertes
          - Centrer automatiquement (si necessaire)
        """
        from src.core.generateur_gcode import (
            generer_gcode, ecrire_fichier, compter_polylignes_ouvertes
        )

        if not self.items_entites:
            QMessageBox.warning(self, "Projet vide", "Aucune entite a graver.")
            return
        if not self.masques:
            QMessageBox.warning(self, "Aucun masque", "Le projet n'a pas de masque.")
            return

        # --- Analyse prealable ---
        selection = [it for it in self.items_entites if it.isSelected()]

        # Toutes les entites (pour la detection polylignes / bbox)
        entites_toutes = [it.entite for it in self.items_entites]
        nb_ouv, nb_tot = compter_polylignes_ouvertes(entites_toutes)

        # Detection coordonnees negatives (sur tout ou selection selon choix futur)
        # On regarde d'abord sur tout, on affinera apres la popup
        x_min_all = None
        y_min_all = None
        for it in self.items_entites:
            for (x, y) in it.entite.points:
                if x_min_all is None or x < x_min_all:
                    x_min_all = x
                if y_min_all is None or y < y_min_all:
                    y_min_all = y
        a_des_negatifs = x_min_all is not None and (x_min_all < 0 or y_min_all < 0)

        # --- Construction de la popup unifiee ---
        boite = QDialog(self)
        boite.setWindowTitle("Generer le G-code")
        boite.setMinimumWidth(480)

        layout = QVBoxLayout(boite)

        # Titre
        titre = QLabel("Options de generation :")
        titre.setStyleSheet("font-weight: bold; padding: 4px;")
        layout.addWidget(titre)

        # Case 1 : Graver uniquement la selection
        check_selection = QCheckBox("Graver uniquement la selection")
        if selection:
            check_selection.setText(
                f"Graver uniquement la selection ({len(selection)} entite(s))"
            )
            check_selection.setEnabled(True)
        else:
            check_selection.setText("Graver uniquement la selection (aucune selection)")
            check_selection.setEnabled(False)
            check_selection.setChecked(False)
        layout.addWidget(check_selection)

        # Case 2 : Graver les polylignes ouvertes
        check_ouvertes = QCheckBox("Graver les polylignes ouvertes")
        if nb_ouv > 0:
            check_ouvertes.setText(
                f"Graver les polylignes ouvertes ({nb_ouv} sur {nb_tot})"
            )
            check_ouvertes.setChecked(True)
            check_ouvertes.setEnabled(True)
        else:
            check_ouvertes.setText("Graver les polylignes ouvertes (aucune detectee)")
            check_ouvertes.setChecked(True)
            check_ouvertes.setEnabled(False)
        layout.addWidget(check_ouvertes)

        # Case 3 : Centrer automatiquement (seulement si negatifs)
        check_centrer = QCheckBox("Centrer automatiquement avant generation")
        if a_des_negatifs:
            check_centrer.setText(
                f"Centrer automatiquement (X min : {x_min_all:.1f}, "
                f"Y min : {y_min_all:.1f})"
            )
            check_centrer.setChecked(True)
            check_centrer.setEnabled(True)
            check_centrer.setStyleSheet("color: #c0392b; font-weight: bold;")
        else:
            check_centrer.setText("Centrer automatiquement (deja dans la zone)")
            check_centrer.setChecked(False)
            check_centrer.setEnabled(False)
        layout.addWidget(check_centrer)

        # Note informative si negatifs
        if a_des_negatifs:
            note = QLabel(
                "Certaines entites sont en dehors de la zone de travail.\n"
                "Il est recommande de cocher la case de centrage."
            )
            note.setStyleSheet("color: #c0392b; padding: 8px; font-size: 11px;")
            note.setWordWrap(True)
            layout.addWidget(note)

        # Boutons OK / Annuler
        boutons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        boutons.accepted.connect(boite.accept)
        boutons.rejected.connect(boite.reject)
        layout.addWidget(boutons)

        if boite.exec() != QDialog.Accepted:
            return

        # --- Application des choix ---
        graver_selection_uniquement = check_selection.isChecked()
        graver_ouvertes = check_ouvertes.isChecked()
        centrer_avant = check_centrer.isChecked()

        # Centrage si demande
        if centrer_avant:
            self.centrer_dans_zone()

        # Selection des entites a graver
        if graver_selection_uniquement:
            # Re-selectionner apres eventuel centrage (les items n'ont pas change)
            selection_apres = [it for it in self.items_entites if it.isSelected()]
            entites = [it.entite for it in selection_apres]
        else:
            entites = [it.entite for it in self.items_entites]

        if not entites:
            QMessageBox.warning(self, "Rien a graver", "Aucune entite a graver.")
            return

        # --- Choix du fichier de sortie ---
        chemin, _ = QFileDialog.getSaveFileName(
            self, "Enregistrer le G-code sous...", "sortie.nc",
            "Fichiers G-code (*.nc *.gcode *.txt);;Tous les fichiers (*.*)"
        )
        if not chemin:
            return

        # --- Recuperation de S_MAX depuis GRBL si connecte ---
        s_max = 1000
        try:
            if self.widget_parent is not None and hasattr(self.widget_parent, 'grbl'):
                grbl = self.widget_parent.grbl
                if grbl is not None and grbl.est_connecte:
                    reps = grbl.envoyer("$$", timeout=3.0)
                    for r in reps:
                        if r.startswith("$30="):
                            s_max = int(r.split("=")[1])
                            break
        except Exception:
            pass

        # --- Generation ---
        lignes = generer_gcode(
            masques=self.masques,
            entites=entites,
            s_max=s_max,
            graver_ouvertes=graver_ouvertes
        )

        # --- Ecriture ---
        try:
            n = ecrire_fichier(chemin, lignes)
        except Exception as e:
            QMessageBox.critical(self, "Erreur d'ecriture",
                                 f"Impossible d'ecrire :\n{e}")
            return

        # --- Message de succes ---
        QMessageBox.information(
            self, "G-code genere",
            f"Fichier : {chemin}\n\n"
            f"{n} lignes ecrites.\n"
            f"S_MAX : {s_max}\n"
            f"Mode : {'selection' if graver_selection_uniquement else 'tout le projet'}"
        )


    def afficher_console(self, texte):
        if self.widget_parent is not None:
            try:
                self.widget_parent.afficher_console(texte)
            except AttributeError:
                pass

    def cadrer_selection(self):
        if self.widget_parent is None:
            return
        grbl = self.widget_parent.grbl
        if grbl is None or not grbl.est_connecte:
            QMessageBox.warning(self, "Non connecte", "Connectez la machine avant de cadrer.")
            return
        selection = [it for it in self.items_entites if it.isSelected()]
        if selection:
            cibles = selection
        else:
            cibles = self.items_entites
            if not cibles:
                QMessageBox.information(self, "Rien a cadrer", "Selectionnez au moins une entite.")
                return
        x_min, y_min, x_max, y_max = self._bbox_selection(cibles)
        self.widget_parent.executer_cadrage(x_min, y_min, x_max, y_max, "selection")

    # -------------------------------------------------------------------------
    # Duplication
    # -------------------------------------------------------------------------

    def dupliquer_selection(self):
        selection = [it for it in self.items_entites
                     if it.isSelected() and not it.verrouillee]
        if not selection:
            QMessageBox.information(self, "Aucune entite",
                                    "Aucune entite non verrouillee selectionnee.")
            return
        decalage = 10.0
        from src.core.dxf_loader import Entite
        nouvelles = []
        for it in selection:
            ent = it.entite
            nouveaux = [(p[0] + decalage, p[1] + decalage) for p in ent.points]
            nouvelles.append(Entite(ent.type_origine, nouveaux, ent.calque, ent.couleur_aci))
        couleurs = {m.nom: m.couleur for m in self.masques}
        for ent in nouvelles:
            path = QPainterPath()
            if not ent.points:
                continue
            pts = [self.origine_vers_scene(p[0], p[1]) for p in ent.points]
            path.moveTo(pts[0].x(), pts[0].y())
            for p in pts[1:]:
                path.lineTo(p.x(), p.y())
            couleur = couleurs.get(ent.calque, QColor("#000000"))
            _masque_li = self._trouver_masque(ent.calque)
            _mode_li = _masque_li.mode_rendu if _masque_li else "line"
            item = EntiteItem(ent, path, couleur, mode_rendu=_mode_li)
            self.scene.addItem(item)
            self.items_entites.append(item)
        for it in selection:
            it.setSelected(False)
            it.appliquer_style()
        for it in self.items_entites[-len(nouvelles):]:
            it.setSelected(True)
            it.appliquer_style()
        self._mettre_a_jour_zone_cadrage()
        self._rafraichir_liste_masques()
        self._maj_label_info()
        self._maj_panneau_redim()

    # -------------------------------------------------------------------------
    # Verrouillage
    # -------------------------------------------------------------------------

    def _ajouter_cadenas(self, item):
        if hasattr(item, '_cadenas_item') and item._cadenas_item is not None:
            return
        cadenas = CadenasItem(item, self)
        if item.scene() is not None:
            item.scene().addItem(cadenas)
        item._cadenas_item = cadenas

    def _supprimer_cadenas(self, item):
        if hasattr(item, '_cadenas_item') and item._cadenas_item is not None:
            if item._cadenas_item.scene() is not None:
                item.scene().removeItem(item._cadenas_item)
            item._cadenas_item = None

    def verrouiller_selection(self):
        selection = [it for it in self.items_entites if it.isSelected()]
        if not selection:
            QMessageBox.information(self, "Aucune selection", "Selectionnez au moins une entite.")
            return
        for it in selection:
            it.verrouillee = True
            it.appliquer_style()
            self._ajouter_cadenas(it)
        self._maj_label_info()

    def deverrouiller_tout(self):
        for it in self.items_entites:
            it.verrouillee = False
            it.appliquer_style()
            self._supprimer_cadenas(it)
        self._maj_label_info()

    # -------------------------------------------------------------------------
    # Bouton supprimer
    # -------------------------------------------------------------------------

    # -------------------------------------------------------------------------
    # Centrage dans la zone
    # -------------------------------------------------------------------------

    def centrer_dans_zone(self):
        """
        Centre la selection (ou tout le projet si rien n'est selectionne)
        au milieu de la zone de travail : (largeur_zone/2, hauteur_zone/2).

        - Lit dynamiquement self.largeur_zone / self.hauteur_zone
        - Exclut les entites verrouillees
        - Si le groupe depasse la zone : avertit dans la console et ne fait rien
        - Sinon : deplace le groupe pour faire coincider le centre de sa bbox
          avec le centre de la zone
        """
        # --- 1. Choix des entites a centrer ---
        selection = [it for it in self.items_entites
                     if it.isSelected() and not it.verrouillee]
        if selection:
            cibles = selection
            cibles_txt = f"{len(selection)} entite(s) selectionnee(s)"
        else:
            cibles = [it for it in self.items_entites if not it.verrouillee]
            cibles_txt = "tout le projet"
            if not cibles:
                self.afficher_console(
                    "[Centrage] Aucune entite non verrouillee."
                )
                return

        # --- 2. Lecture dynamique de la zone ---
        lz = float(self.largeur_zone)
        hz = float(self.hauteur_zone)

        # --- 3. BBox de la selection (coordonnees MACHINE) ---
        x_min, y_min, x_max, y_max = self._bbox_selection(cibles)
        largeur_item = x_max - x_min
        hauteur_item = y_max - y_min

        # --- 4. Verification de depassement ---
        if largeur_item > lz or hauteur_item > hz:
            self.afficher_console(
                f"[Centrage] ATTENTION : le groupe "
                f"({largeur_item:.1f} x {hauteur_item:.1f} mm) "
                f"depasse la zone ({lz:.1f} x {hz:.1f} mm). Centrage annule."
            )
            return

        # --- 5. Calcul du deplacement pour centrer au milieu ---
        centre_item_x = (x_min + x_max) / 2.0
        centre_item_y = (y_min + y_max) / 2.0
        dx = (lz / 2.0) - centre_item_x
        dy = (hz / 2.0) - centre_item_y

        if abs(dx) < 0.01 and abs(dy) < 0.01:
            self.afficher_console(
                "[Centrage] Les elements sont deja centres dans la zone."
            )
            return

        # --- 6. Application du deplacement sur les modeles ---
        for it in cibles:
            ent = it.entite
            ent.points = [(p[0] + dx, p[1] + dy) for p in ent.points]

        # --- 7. Rafraichissement ---
        self._rafraichir_items_depuis_modeles()
        self._mettre_a_jour_zone_cadrage()
        self._maj_panneau_redim()
        self._maj_regles()

        self.afficher_console(
            f"[Centrage] {cibles_txt} centre(s) dans la zone "
            f"(deplacement {dx:+.1f}, {dy:+.1f} mm)."
        )

    def diagnostiquer_entites(self):
        """
        Diagnostic : compare le nombre d'entites dans self.items_entites
        avec le nombre d'EntiteItem presents dans la scene.
        Affiche aussi les infos de chaque entite problematique.
        """
        from PySide6.QtWidgets import QGraphicsPathItem

        items_python = self.items_entites
        items_scene = [it for it in self.scene.items()
                       if isinstance(it, EntiteItem)]

        print("=== DIAGNOSTIC ===")
        print(f"items_entites (Python) : {len(items_python)}")
        print(f"items dans la scene    : {len(items_scene)}")

        # Items dans la scene mais PAS dans items_entites (orphelins)
        ids_python = set(id(it) for it in items_python)
        orphelins = [it for it in items_scene if id(it) not in ids_python]
        print(f"ORPHELINS (scene mais pas Python) : {len(orphelins)}")
        for it in orphelins:
            rect = it.boundingRect()
            print(f"  - Orphelin : position scene = ({rect.x():.2f}, {rect.y():.2f}), "
                  f"taille = {rect.width():.2f} x {rect.height():.2f}, "
                  f"verrouillee = {getattr(it, 'verrouillee', 'N/A')}")
            # Verifie si l'entite a des points
            if hasattr(it, 'entite') and it.entite is not None:
                print(f"    ent.points : {len(it.entite.points)} points")

        # Items dans items_entites mais verrouilles
        verr = [it for it in items_python if getattr(it, 'verrouillee', False)]
        print(f"Entites VERROUILLEES : {len(verr)}")
        for it in verr:
            rect = it.boundingRect()
            print(f"  - Verrouillee : position = ({rect.x():.2f}, {rect.y():.2f})")

        # Items avec points vides
        vides = [it for it in items_python
                 if hasattr(it, 'entite') and it.entite is not None
                 and len(it.entite.points) == 0]
        print(f"Entites avec points VIDES : {len(vides)}")

        print("=== FIN DIAGNOSTIC ===")

    def _maj_bouton_supprimer(self):
        selection = [it for it in self.items_entites
                     if it.isSelected() and not it.verrouillee]
        self.btn_supprimer.setEnabled(len(selection) > 0)


