# =============================================================================
# Classe : BoutonCouleur
# =============================================================================

class BoutonCouleur(QPushButton):
    """Bouton carre colore, utilise dans le dialogue de creation de masque."""

    def __init__(self, couleur_hex, parent=None):
        super().__init__(parent)
        self.couleur_hex = couleur_hex
        self.setFixedSize(40, 40)
        self.setCheckable(True)
        self._maj_style()

    def _maj_style(self):
        bordure = "3px solid #000000" if self.isChecked() else "1px solid #888888"
        self.setStyleSheet(
            f"QPushButton {{ background-color: {self.couleur_hex}; "
            f"border: {bordure}; border-radius: 4px; }}"
        )

    def setChecked(self, checked):
        super().setChecked(checked)
        self._maj_style()


# =============================================================================
# Classe : DialogueCreationMasque
# =============================================================================

class DialogueCreationMasque(QDialog):
    """Dialogue de creation de masque : nom + choix parmi les 8 couleurs."""

    def __init__(self, nom_defaut="", parent=None):
        super().__init__(parent)
        self.setWindowTitle("Creer un masque")
        self.setMinimumWidth(400)

        self.couleur_choisie = None

        layout = QVBoxLayout(self)

        form = QFormLayout()
        self.champ_nom = QLineEdit(nom_defaut)
        form.addRow("Nom du masque :", self.champ_nom)
        layout.addLayout(form)

        label_couleur = QLabel("Couleur :")
        layout.addWidget(label_couleur)

        grille = QGrid()
        grille.setSpacing(6)
        self.boutons_couleur = []

        for i, (nom_couleur, hex_code) in enumerate(PALETTE_MASQUES):
            btn = BoutonCouleur(hex_code)
            btn.setToolTip(nom_couleur)
            btn.clicked.connect(lambda checked=False, idx=i: self._choisir_couleur(idx))
            grille.addWidget(btn, i // 4, i % 4)
            self.boutons_couleur.append(btn)

        layout.addLayout(grille)

        # --- Bouton "Autre couleur..." ---
        self.btn_autre_couleur = QPushButton("Autre couleur...")
        self.btn_autre_couleur.clicked.connect(self._choisir_autre_couleur)
        layout.addWidget(self.btn_autre_couleur)

        boutons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        boutons.accepted.connect(self.accept)
        boutons.rejected.connect(self.reject)
        layout.addWidget(boutons)

        # Etat interne : couleur personnalisee eventuelle
        self.couleur_personnalisee = None

        self._choisir_couleur(0)

    def _choisir_couleur(self, index):
        for i, btn in enumerate(self.boutons_couleur):
            btn.setChecked(i == index)
        self.couleur_choisie = PALETTE_MASQUES[index][1]
        # Reinitialiser la couleur personnalisee quand on choisit
        # une couleur de la palette
        self.couleur_personnalisee = None

    def _choisir_autre_couleur(self):
        """Ouvre le selecteur de couleur Qt pour choisir une couleur libre."""
        from PySide6.QtWidgets import QColorDialog
        # Couleur initiale = celle actuellement choisie
        couleur_init = QColor(self.couleur_choisie) if self.couleur_choisie else QColor("#000000")
        couleur = QColorDialog.getColor(
            couleur_init, self, "Choisir une couleur"
        )
        if not couleur.isValid():
            return
        # Memoriser
        self.couleur_personnalisee = couleur.name()
        self.couleur_choisie = couleur.name()
        # Decocher tous les boutons palette (on n'est plus sur la palette)
        for btn in self.boutons_couleur:
            btn.setChecked(False)

    def get_resultat(self):
        nom = self.champ_nom.text().strip()
        if not nom:
            return None, None
        return nom, self.couleur_choisie


# =============================================================================
# Classe : CadenasItem
# =============================================================================

class CadenasItem(QGraphicsSimpleTextItem):
    """
    Petit cadenas cliquable, attache a une entite verrouillee.

    Comportement :
      - Clic gauche  : deverrouille l'entite associee
      - Clic droit   : menu contextuel avec option Deverrouiller
      - Survol       : curseur main + couleur changee
      - Taille fixe a l'ecran (independant du zoom)
    """

    def __init__(self, entite_item, widget_parent):
        super().__init__("\U0001F512")  # emoji cadenas
        self.entite_item = entite_item
        self.widget_parent = widget_parent

        self.setBrush(QBrush(QColor("#c0392b")))
        font = self.font()
        font.setPointSize(14)
        font.setBold(True)
        self.setFont(font)

        self.setFlag(QGraphicsSimpleTextItem.ItemIgnoresTransformations, True)
        self.setFlag(QGraphicsSimpleTextItem.ItemIsSelectable, True)
        self.setAcceptHoverEvents(True)
        self.setCursor(Qt.PointingHandCursor)

        self.mettre_a_jour_position()

    def mettre_a_jour_position(self):
        """Recalcule la position du cadenas a partir de la bbox de l'entite."""
        if self.entite_item is None:
            return
        rect = self.entite_item.boundingRect()
        self.setPos(rect.left() - 4, rect.top() - 16)

    def hoverEnterEvent(self, event):
        self.setBrush(QBrush(QColor("#e67e22")))
        self.setCursor(Qt.PointingHandCursor)
        super().hoverEnterEvent(event)

    def hoverLeaveEvent(self, event):
        self.setBrush(QBrush(QColor("#c0392b")))
        self.unsetCursor()
        super().hoverLeaveEvent(event)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.deverrouiller()
            event.accept()
            return
        super().mousePressEvent(event)

    def mouseDoubleClickEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.deverrouiller()
            event.accept()
            return
        super().mouseDoubleClickEvent(event)

    def contextMenuEvent(self, event):
        menu = QMenu()
        action = menu.addAction("Deverrouiller cette entite")
        action.triggered.connect(self.deverrouiller)
        menu.exec(event.screenPos())

    def deverrouiller(self):
        if self.entite_item is None:
            return
        self.entite_item.verrouillee = False
        self.entite_item.appliquer_style()
        if self.scene() is not None:
            self.scene().removeItem(self)
        self.entite_item._cadenas_item = None


# =============================================================================
# Classe : MesureItem
# =============================================================================

class MesureItem(QGraphicsItemGroup):
    """
    Groupe graphique affichant une mesure entre 2 points :
      - 2 marqueurs rouges
      - une ligne en pointilles
      - un label avec distance, dX, dY (taille fixe a l'ecran)
    """

    def __init__(self, p1, p2):
        super().__init__()
        self.p1 = p1
        self.p2 = p2

        TAILLE_MARQUEUR = 6
        for point in (p1, p2):
            marqueur = QGraphicsEllipseItem(
                point.x() - TAILLE_MARQUEUR / 2,
                point.y() - TAILLE_MARQUEUR / 2,
                TAILLE_MARQUEUR, TAILLE_MARQUEUR
            )
            marqueur.setBrush(QBrush(QColor("#e74c3c")))
            marqueur.setPen(QPen(Qt.NoPen))
            marqueur.setFlag(QGraphicsEllipseItem.ItemIgnoresTransformations, True)
            self.addToGroup(marqueur)

        ligne = QGraphicsLineItem(p1.x(), p1.y(), p2.x(), p2.y())
        pen = QPen(QColor("#e74c3c"))
        pen.setStyle(Qt.DashLine)
        pen.setWidthF(1.5)
        pen.setCosmetic(True)
        ligne.setPen(pen)
        self.addToGroup(ligne)

        milieu_x = (p1.x() + p2.x()) / 2
        milieu_y = (p1.y() + p2.y()) / 2

        dx = p2.x() - p1.x()
        dy = p2.y() - p1.y()
        distance = math.hypot(dx, dy)

        texte = f"{distance:.2f} mm\nDx = {dx:.2f}\nDy = {dy:.2f}"

        label = QGraphicsSimpleTextItem(texte)
        label.setBrush(QBrush(QColor("#c0392b")))
        font = label.font()
        font.setPointSize(9)
        font.setBold(True)
        label.setFont(font)
        label.setFlag(QGraphicsSimpleTextItem.ItemIgnoresTransformations, True)
        label.setPos(milieu_x, milieu_y)

        rect = label.boundingRect()
        label.setTransformOriginPoint(rect.width() / 2, rect.height())
        label.moveBy(0, -5)

        self.addToGroup(label)



# =============================================================================
# Classe : EntiteItem
# =============================================================================

class EntiteItem(QGraphicsPathItem):
    """Item graphique d'une entite DXF, selectionnable, verrouillable."""

    def __init__(self, entite, path, couleur, mode_rendu="line", est_trou=False):
        super().__init__(path)
        self.entite = entite
        self.couleur_base = couleur
        self.verrouillee = False
        self._cadenas_item = None
        self.mode_rendu = mode_rendu    # "line", "fill", "line+fill"
        self.est_trou = est_trou        # True si c'est un trou (ex: "o", "a")
        self.setFlag(QGraphicsPathItem.ItemIsSelectable, True)
        self.setAcceptHoverEvents(False)

        pen = QPen(couleur)
        pen.setWidthF(EPAISSEUR_NORMALE)
        pen.setCosmetic(True)
        self.setPen(pen)

        self.appliquer_style()

    def appliquer_style(self):
        # Priorite 1 : entite verrouillee -> gris fonce
        if self.verrouillee:
            couleur_gris = QColor(85, 85, 85, 230)
            if self.isSelected():
                couleur_gris = QColor(80, 110, 180, 240)
            pen = QPen(couleur_gris)
            pen.setWidthF(1.0)
            pen.setCosmetic(True)
            pen.setStyle(Qt.DashLine)
            self.setPen(pen)
            self._appliquer_brush()
            return

        # Priorite 2 : entite selectionnee -> bleu vif
        if self.isSelected():
            pen = QPen(COULEUR_SELECTION)
            pen.setWidthF(EPAISSEUR_SELECTION)
            pen.setCosmetic(True)
            self.setPen(pen)
            self._appliquer_brush()
            return

        # Priorite 3 : entite normale -> couleur du masque
        # Le style du pen depend du mode de rendu
        pen = QPen(self.couleur_base)
        if self.mode_rendu == "fill":
            # Mode fill pur : contour tres fin
            pen.setWidthF(0.5)
        else:
            # Mode line ou line+fill : contour normal
            pen.setWidthF(EPAISSEUR_NORMALE)
        pen.setCosmetic(True)
        self.setPen(pen)
        self._appliquer_brush()

    def _appliquer_brush(self):
        # Applique le brush (remplissage) selon le mode de rendu.
        # Si est_trou=True (ex: interieur d'un "o"), pas de remplissage.
        if self.est_trou:
            self.setBrush(QBrush(Qt.NoBrush))
            return

        if self.mode_rendu in ("fill", "line+fill"):
            couleur_fill = QColor(self.couleur_base)
            couleur_fill.setAlpha(10)  # ~4% opacite
            self.setBrush(QBrush(couleur_fill))
        else:
            self.setBrush(QBrush(Qt.NoBrush))

    def set_mode_rendu(self, mode):
        """Change le mode de rendu et rafraichit l'affichage."""
        self.mode_rendu = mode
        self.appliquer_style()

    def set_couleur(self, couleur):
        self.couleur_base = couleur
        self.appliquer_style()


